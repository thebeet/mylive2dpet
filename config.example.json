{
  "conversation": {
    "enabled": true,
    "history": {
      "maxTurns": 32,
      "keepTurns": 4,
      "maxInputTokens": 50000,
      "hardInputTokens": 100000,
      "summaryMaxTokens": 4096,
      "summaryMaxChars": 6000
    },
    "ai": {
      "endpoint": "https://your-api.example.com/v1",
      "proxy": "http://127.0.0.1:7890",
      "model": "gpt-4o",
      "outputFormat": "auto",
      "apiKey": "sk-xxx",
      "max_tokens": 1024,
      "timeoutMs": 120000,
      "retryBudgetMs": 360000
    },
    "character": {
      "cardName": "后辈",
      "name": "Setsuna",
      "userIdentity": "后辈",
      "userTerm": "前辈",
      "description": "你是{{petName}}，用户的{{userIdentity}}。……",
      "personality": "温柔清楚。……",
      "scenario": "你的存在提供「陪伴感」和「节奏感」。……",
      "rules": "【规则——必须严格遵守】\n1. 只回复1-2句话……",
      "language": "中文"
    },
    "_comment": "核心对话：模型设置与角色策略；enabled 控制对话和共享文本生成。"
  },
  "ui": {
    "windowWidth": 380,
    "windowHeight": 560,
    "alwaysOnTop": true
  },
  "decision": {
    "enabled": true,
    "interval_ms": 10000,
    "_comment": "每次决策结束后等待 interval_ms，负数关闭自动决策，保留手动触发。"
  },
  "plugins": [
    {
      "name": "avatar-live2d",
      "enabled": true,
      "modelPath": "assets/Setsuna_v081l_b/setsuna_psd2live_v001.model3.json",
      "iconPath": "assets/Setsuna_v081l_b/icon.png",
      "scale": 1.5,
      "verticalOffset": 50,
      "defaultExpression": "neutral",
      "idleMotion": {
        "group": "Thinking",
        "index": 0
      },
      "clickMotion": {
        "group": "ReachStudy",
        "index": 0
      }
    },
    {
      "name": "avatar-3d",
      "physicsEnabled": true,
      "enabled": false,
      "modelPath": "assets/【芙宁娜】/【芙宁娜】.pmx",
      "scale": 1,
      "verticalOffset": 0,
      "rotationY": 0
    },
    {
      "name": "web-search",
      "enabled": false,
      "searchProvider": "deepseek",
      "fetchProvider": "deepseek",
      "providers": {
        "deepseek": {
          "endpoint": "https://api.deepseek.com/v1",
          "apiKey": ""
        },
        "openai": {
          "endpoint": "https://api.openai.com/v1",
          "apiKey": "",
          "model": ""
        }
      },
      "_comment": "网页搜索/读取独立 provider。启用前填所选 provider 的 key；OpenAI 搜索需指定支持 web_search 的模型，不提供独立 Fetch，可搭配 DeepSeek。"
    },
    {
      "name": "rss",
      "enabled": false,
      "feeds": [
        {
          "name": "示例订阅",
          "url": "https://example.com/feed.xml",
          "proxy": "",
          "interval_ms": 600000
        }
      ],
      "interval_ms": 300000,
      "timeoutMs": 20000,
      "emitOnFirstFetch": false,
      "observationTtlMs": 0,
      "maxContentChars": 12000,
      "maxResponseBytes": 2097152,
      "_comment": "RSS/Atom 感知：启动立即检查；每个 feed 可设置 interval_ms，未设置使用插件全局间隔。首次成功读取只建立基线，之后新增和修改条目提交观察队列。每个 feed 的 proxy 为独立 HTTP(S) 代理，留空直连。"
    },
    {
      "name": "codex-observer",
      "enabled": false,
      "sessionsDir": "~/.codex/sessions",
      "projects": [],
      "interval_ms": 2000,
      "observationTtlMs": 0,
      "_comment": "Codex 提示词观察：首次启用跳过旧会话内容，之后增量读取已提交的用户文字，以 context 正常入队，不主动请求回应。projects 留空观察全部项目，或填写项目绝对路径（包含子目录）。自定义 CODEX_HOME 时调整 sessionsDir。"
    },
    {
      "name": "gitlab",
      "enabled": false,
      "baseUrl": "https://gitlab.com",
      "token": "",
      "tokenEnv": "GITLAB_TOKEN",
      "proxy": "",
      "projects": [
        {
          "id": "group/project",
          "name": "示例项目",
          "ref": "main",
          "statuses": [
            "failed",
            "success"
          ]
        }
      ],
      "interval_ms": 60000,
      "timeoutMs": 20000,
      "emitOnFirstFetch": false,
      "observationTtlMs": 0,
      "lookbackMs": 604800000,
      "maxPages": 20,
      "maxResponseBytes": 2097152,
      "_comment": "GitLab 流水线感知：填写实例地址和项目 ID/路径，配置 token 或启动进程环境变量 tokenEnv 后启用。statuses 留空关注全部状态，ref 留空关注全部分支。首次读取建立基线，后续新增或状态变化只提交观察队列。"
    },
    {
      "name": "schedule",
      "enabled": true,
      "observationTtlMs": 0,
      "maxRetries": 2,
      "retryDelayMs": 30000,
      "_comment": "定时通知：默认启用，到期只提交 context 观察，不主动触发决策；未入队通知启动后补发。observationTtlMs=0 不设置观察有效期。"
    },
    {
      "name": "manual-input",
      "enabled": true,
      "_comment": "手动对话插件：右键输入窗口、用户文本观察与即时决策请求；默认启用。"
    },
    {
      "name": "storage-sqlite",
      "enabled": true,
      "path": "pet.sqlite3",
      "busyTimeoutMs": 5000
    },
    {
      "name": "dialogue-history",
      "enabled": true,
      "storageService": "storage"
    },
    {
      "name": "raw-log",
      "enabled": true,
      "_comment": "原始请求日志：按聊天消息查看每次模型请求，包含图片、重试与返回结果，保存到 SQLite；默认启用。"
    },
    {
      "name": "screen-perception",
      "enabled": true,
      "interval_ms": 5000,
      "changeDetect": {
        "enabled": true,
        "hashSize": 8,
        "threshold": 4
      },
      "_comment": "视觉感知插件：enabled 控制自动截图，手动截图仍可用。",
      "observationTtlMs": 60000
    },
    {
      "name": "camera-perception",
      "enabled": false,
      "deviceId": "",
      "changeDetect": {
        "enabled": true,
        "hashSize": 8,
        "threshold": 4
      },
      "interval_ms": 5000,
      "width": 640,
      "height": 480,
      "observationTtlMs": 60000,
      "maxPendingObservations": 6,
      "_comment": "摄像头画面定时入队；菜单枚举设备，点击预览可切换感知，关闭预览不影响后台采集。默认关闭。"
    },
    {
      "name": "audio-output-perception",
      "enabled": true,
      "sources": [
        {
          "type": "output",
          "source": "default",
          "label": "电脑播放",
          "enabled": true
        },
        {
          "type": "microphone",
          "source": "default",
          "label": "麦克风",
          "enabled": false
        }
      ],
      "speechThresholdDb": -40,
      "minSpeechMs": 400,
      "silenceMs": 800,
      "maxSegmentMs": 15000,
      "ttsCooldownMs": 600,
      "_comment": "Linux PipeWire/PulseAudio 多声音源；output 监听播放声音，microphone 监听输入；source 可填 default 或 pactl 源名称。每项 enabled 控制自动采集，菜单可独立开启；不保存原始音频。",
      "asr": {
        "provider": "funasr",
        "endpoint": "ws://127.0.0.1:10096",
        "apiKey": "",
        "language": "zh",
        "chunkSize": [
          5,
          10,
          5
        ],
        "chunkInterval": 10,
        "proxy": "",
        "timeoutMs": 60000,
        "_comment": "funasr 使用 WebSocket 2-pass，流式字幕与最终修正分开处理，模型由服务端选择；chunkSize [5,10,5] 对应 600ms 解码窗口，每次发送 60ms PCM。language 为结果标签，不切换模型。仍支持 whisper-asr-webservice 和 openai。"
      }
    },
    {
      "name": "tts",
      "enabled": false,
      "provider": "openai-compatible",
      "interruptOnNewChat": true,
      "_comment_provider": "system | gpt-sovits | openai-compatible。docker 模式自动部署本地 CosyVoice；云端或自管服务使用 service.type=external 并填写 apiBase、apiKey、model、voice。详见 TTS 插件文档。",
      "service": {
        "type": "docker",
        "preset": "cosyvoice"
      },
      "refAudio": "assets/voice/reference.wav",
      "promptText": "参考音频对应的实际台词。",
      "_comment_voice": "本地填写 refAudio 后自动创建并复用音色，无需手动获取 ID；也可填写已有 voice ID。",
      "responseFormat": "wav",
      "speed": 1,
      "timeoutMs": 120000
    },
    {
      "name": "memory",
      "enabled": true,
      "storageService": "storage",
      "shortTerm": {
        "enabled": true,
        "maxTurns": 8,
        "ttlMs": 1800000
      },
      "store": {
        "enabled": true,
        "maxEntries": 5000,
        "eventRetentionDays": 30
      },
      "maintenance": {
        "batchSize": 16,
        "extractEveryNEvents": 3,
        "flushAfterMs": 60000,
        "pollMs": 15000,
        "maxSourceChars": 24000,
        "maxContextChars": 32000,
        "maxTokens": 8192,
        "candidateLimit": 48
      },
      "retrieval": {
        "maxInject": 8,
        "maxPinned": 6,
        "maxContextChars": 12000,
        "minSimilarity": 0.45
      },
      "embedding": {
        "enabled": false,
        "endpoint": "",
        "model": "",
        "apiKey": "",
        "proxy": "",
        "timeoutMs": 4000,
        "batchSize": 16,
        "_comment": "可选：填写兼容 embeddings 的服务以启用向量与中文全文混合检索；默认不发送 embedding 请求。"
      },
      "questions": {
        "enabled": false,
        "maxQuestions": 30
      },
      "_comment": "模型自由组织主题、标签、别称与关联，适用于日常交流和各种活动；直接用户表达尽快维护，背景观察按批处理。"
    },
    {
      "name": "questions",
      "enabled": true,
      "auto": true,
      "dailyLimit": 3,
      "cooldownMs": 1800000,
      "deferMs": 1800000,
      "minIdleSeconds": 8,
      "maxIdleSeconds": 300,
      "maxSkips": 3,
      "pollMs": 15000,
      "timeoutMs": 90000
    }
  ],
  "observations": {
    "maxPending": 128,
    "maxBatch": 16,
    "maxRetries": 2,
    "perSource": {
      "screen": 6,
      "audio-output": 20,
      "manual-input": 100
    },
    "_comment": "用户消息优先；容量不足时拒绝新增用户消息，补充观察淘汰最旧项；有限重试，已接收的用户消息回队时保留。"
  }
}
