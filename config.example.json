{
  "ui": {
    "windowWidth": 380,
    "windowHeight": 560,
    "alwaysOnTop": true
  },
  "decision": {
    "provider": "ai-conversation",
    "enabled": true,
    "interval_ms": 10000,
    "_comment": "选择已注册的决策插件；每次结束后等待 interval_ms，负数关闭自动决策，保留手动触发。"
  },
  "plugins": [
    {
      "name": "manual-input",
      "enabled": true,
      "_comment": "手动对话插件：右键输入窗口、用户文本观察与即时决策请求；默认启用。"
    },
    {
      "name": "storage-sqlite",
      "enabled": true,
      "path": "pet.sqlite3",
      "busyTimeoutMs": 5000
    },
    {
      "name": "dialogue-history",
      "enabled": true,
      "storageService": "storage-sqlite.database",
      "legacyPath": "logs/dialogue-history.jsonl"
    },
    {
      "name": "raw-log",
      "enabled": true,
      "_comment": "原始请求日志：按聊天消息查看每次模型请求，包含图片、重试与返回结果，保存到 SQLite；默认启用。"
    },
    {
      "name": "ai-conversation",
      "enabled": true,
      "ai": {
        "endpoint": "https://your-api.example.com/v1",
        "proxy": "http://127.0.0.1:7890",
        "model": "gpt-4o",
        "apiKey": "sk-xxx",
        "max_tokens": 1024,
        "timeoutMs": 120000,
        "retryBudgetMs": 360000
      },
      "character": {
        "cardName": "后辈",
        "name": "Setsuna",
        "userIdentity": "后辈",
        "userTerm": "前辈",
        "description": "你是{{petName}}，用户的{{userIdentity}}。……",
        "personality": "温柔清楚。……",
        "scenario": "你的存在提供「陪伴感」和「节奏感」。……",
        "rules": "【规则——必须严格遵守】\n1. 只回复1-2句话……",
        "language": "中文"
      },
      "_comment": "AI 对话插件：模型请求、提示词与结果解析。"
    },
    {
      "name": "screen-perception",
      "enabled": true,
      "interval_ms": 5000,
      "changeDetect": {
        "enabled": true,
        "hashSize": 8,
        "threshold": 4
      },
      "_comment": "视觉感知插件：enabled 控制自动截图，手动截图仍可用。",
      "observationTtlMs": 60000
    },
    {
      "name": "audio-output-perception",
      "enabled": true,
      "source": "default",
      "speechThresholdDb": -40,
      "minSpeechMs": 400,
      "silenceMs": 800,
      "maxSegmentMs": 15000,
      "ttsCooldownMs": 600,
      "_comment": "Linux PipeWire/PulseAudio 输出监视源；source 可填具体 .monitor 名称；默认不保存原始音频。",
      "asr": {
        "provider": "whisper-asr-webservice",
        "endpoint": "http://127.0.0.1:9000",
        "apiKey": "",
        "language": "zh",
        "vadFilter": true,
        "proxy": "",
        "timeoutMs": 60000,
        "_comment": "whisper-asr-webservice 对接 /asr，模型由容器 ASR_MODEL 选择；openai 对接 /audio/transcriptions 并需配置 model。language 留空自动识别。"
      }
    },
    {
      "name": "tts",
      "enabled": false,
      "provider": "gpt-sovits",
      "interruptOnNewChat": true,
      "_comment_provider": "system | gpt-sovits。gpt-sovits 需本机先启动 GPT-SoVITS api_v2.py（默认 9880）",
      "apiBase": "http://127.0.0.1:9880",
      "apiVersion": "v2",
      "gptWeights": "assets/v2ProPlus/流萤/流萤-e10.ckpt",
      "sovitsWeights": "assets/v2ProPlus/流萤/流萤_e10_s250.pth",
      "refAudio": "assets/v2ProPlus/流萤/reference_audios/中文/emotions/【中立】…我应该会选择请求猎犬家系停止追捕。.wav",
      "refAudioApiPath": "",
      "_comment_refAudioApiPath": "GPT-SoVITS 服务端看到的参考音频路径；留空则发送 refAudio 解析后的本机路径",
      "promptText": "",
      "_comment_promptText": "留空则从 refAudio 文件名去掉【情感】后自动推断",
      "textLang": "zh",
      "promptLang": "zh",
      "speedFactor": 1,
      "rate": 0
    },
    {
      "name": "memory",
      "enabled": true,
      "textService": "ai-conversation.text",
      "shortTerm": {
        "enabled": true,
        "maxTurns": 8,
        "ttlMs": 1800000,
        "_comment": "近期对话与观察缓冲，注入用户消息的补充上下文；不存旧截图"
      },
      "longTerm": {
        "maxInject": 5,
        "extractEveryNTurns": 20,
        "maxTokens": 16384,
        "maxEntries": 500,
        "enabled": true,
        "legacyPath": "logs/memory.jsonl",
        "_comment": "每20次非静默对话，将完整待处理对话和现有长期记忆一起更新；优先修改已有条目，新增要求高价值且有明确来源"
      },
      "_comment": "统一记忆插件：enabled 控制整个插件；shortTerm/longTerm 可独立关闭。",
      "storageService": "storage-sqlite.database",
      "work": {
        "enabled": true,
        "extractEveryNObservations": 3,
        "flushAfterMs": 120000,
        "batchSize": 16,
        "maxTokens": 1800,
        "maxEvidence": 2000,
        "maxQuestions": 30,
        "maxClaims": 20,
        "maxContextChars": 8000,
        "_comment": "从飞书截图、文档和会议转写完善人物与项目画像，允许可修正的猜测"
      }
    },
    {
      "name": "questions",
      "enabled": true,
      "auto": true,
      "dailyLimit": 0,
      "cooldownMs": 0,
      "deferMs": 1800000,
      "minIdleSeconds": 8,
      "maxIdleSeconds": 300,
      "maxSkips": 3,
      "pollMs": 15000,
      "timeoutMs": 90000
    }
  ],
  "observations": {
    "maxPending": 128,
    "maxBatch": 16,
    "maxRetries": 2,
    "perSource": {
      "screen": 6,
      "audio-output": 20,
      "manual-input": 100
    },
    "_comment": "用户消息优先；容量不足时拒绝新增用户消息，补充观察淘汰最旧项；有限重试，已接收的用户消息回队时保留。"
  }
}
