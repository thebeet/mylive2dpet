{
  "name": "mylive2dpet",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "desktop": "npm run start",
    "build": "vite build",
    "preview": "vite preview",
    "test:audio": "node --test tests/audioOutput.test.js tests/audioLiveWindow.test.js tests/funasr.test.js",
    "test": "node --test tests/*.test.js",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:native",
    "prestart": "electron-rebuild -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "sirv": "^3.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-static-copy": "^2.2.0",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "https-proxy-agent": "^7.0.6",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.2",
    "ws": "^8.22.0",
    "x11": "^4.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
